<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Required by flutter_secure_storage so the app can use its own keychain
	  access group. The stored items themselves use
	  kSecAttrAccessibleAfterFirstUnlockThisDeviceOnly and are not synchronised
	  to iCloud, so the keys never leave this device.
	-->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)app.lyberry.lyberry</string>
	</array>
</dict>
</plist>
