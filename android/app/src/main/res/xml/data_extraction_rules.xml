<?xml version="1.0" encoding="utf-8"?>
<!--
  Lyberry 0.3.0 data extraction rules (Android 12+).

  Credential preferences (the FlutterSecureStorage file holding the user's own
  Tavily / DeepSeek keys) are excluded from both cloud backup and device
  transfer. Library data stays in the SQLite database and keeps the platform's
  normal backup behaviour.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="."/>
    </device-transfer>
</data-extraction-rules>
